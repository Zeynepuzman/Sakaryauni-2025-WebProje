@model WebProje_B231210095.Models.ViewModels.RandevuCreateVM

@{
    ViewData["Title"] = "Randevu Düzenle";
}

<h2 class="fw-bold mb-4">Randevu Düzenle</h2>

<form asp-action="Edit" asp-route-id="@ViewBag.RandevuId" method="post">
    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label class="fw-semibold">Antrenör</label>
        <select asp-for="AntrenorId" class="form-control" asp-items="ViewBag.Antrenorler">
            <option value="">Antrenör seçiniz</option>
        </select>
    </div>

    <div class="mb-3">
        <label class="fw-semibold">Tarih</label>
        <input asp-for="Tarih" type="date" class="form-control" min="@DateTime.Now.ToString("yyyy-MM-dd")" />
    </div>

    <div class="mb-3">
        <label class="fw-semibold">Saat</label>
        <input asp-for="Saat"
               type="time"
               class="form-control"
               min="09:00"
               max="22:00"
               step="600" />
        <small class="text-muted">
            Randevular 09:00–22:00 arası ve 10 dakikalık aralıklarla alınabilir.
        </small>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-success">
            Kaydet
        </button>

        <a asp-action="Dashboard" asp-controller="Uye" class="btn btn-secondary">
            İptal
        </a>
    </div>
</form>
