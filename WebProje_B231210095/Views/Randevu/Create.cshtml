@model WebProje_B231210095.Models.ViewModels.RandevuCreateVM


<h2 class="fw-bold mb-4 text-center">Randevu Al</h2>

<div class="container" style="max-width:700px;">
    <div class="card shadow-sm p-4 rounded-4">

        <div class="mb-3">
            <label class="fw-semibold">Aktif Paket</label>
            <input class="form-control" value="@ViewBag.PaketAdi" disabled />
        </div>

        <div class="mb-3">
            <label class="fw-semibold">Hizmet</label>
            <input class="form-control" value="@ViewBag.HizmetAdi" disabled />
        </div>

        <form method="post">

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert alert-danger">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            <div class="mb-3">
                <label class="fw-semibold">Antrenör</label>

                <select asp-for="AntrenorId"
                        asp-items="ViewBag.Antrenorler"
                        class="form-select">
                    <option value="">-- Antrenör Seçiniz --</option>
                </select>

                <span asp-validation-for="AntrenorId" class="text-danger"></span>
            </div>

            <input asp-for="Tarih" type="date" class="form-control" min="@DateTime.Now.ToString("yyyy-MM-dd")" required />

            <div class="mb-3">
                <label class="fw-semibold">Saat</label>
                <select asp-for="Saat" class="form-control" required>
                    <option value="">Saat seçiniz</option>

                    @for (int hour = 9; hour <= 22; hour++)
                    {
                        for (int minute = 0; minute < 60; minute += 10)
                        {
                            if (hour == 22 && minute > 0)
                            {
                                break;
                            }

                            var timeValue = new TimeSpan(hour, minute, 0);
                            <option value="@timeValue">
                                @($"{hour:D2}:{minute:D2}")
                            </option>
                        }
                    }
                </select>

                <small class="text-muted">
                    Randevular 09:00 – 22:00 arası, 10 dakikalık aralıklarla alınır.
                </small>
            </div>



            <div class="d-flex justify-content-between mt-4">
                <a asp-controller="Uye" asp-action="Dashboard"
                   class="btn btn-outline-secondary">
                    ← Geri Dön
                </a>

                <button type="submit"
                        class="btn btn-powerzone rounded-pill px-4">
                    Randevu Oluştur
                </button>
            </div>

        </form>
    </div>
</div>
