@model WebProje_B231210095.Models.Uye

@{
    ViewData["Title"] = "Kullanıcı Paneli";
}

<div class="row g-4">

    <!-- AKTİF PAKET -->
    <div style="height:40px;"></div>

    <div class="container">

        <h2 class="fw-bold mb-4">
            Hoş geldin, @Model.AdSoyad 👋
        </h2>

        <div class="row g-4 align-items-stretch">

            <!-- AKTİF PAKET -->
            <div class="col-md-8">
                @if (ViewBag.AktifPaket != null)
                {
                    <div class="card shadow-sm p-4 rounded-4 h-100">
                        <h5 class="fw-bold text-teal mb-2">Aktif Paketiniz</h5>

                        <p><strong>Paket:</strong> @ViewBag.AktifPaket.PaketAdi</p>
                        <p><strong>Kalan Gün:</strong> @ViewBag.AktifPaket.KalanGun gün</p>

                        <div class="d-flex gap-3 mt-3">
                            <a asp-controller="Randevu"
                               asp-action="Create"
                               class="btn btn-powerzone rounded-pill px-4">
                                Randevu Al
                            </a>

                            <a asp-controller="Paket"
                               asp-action="Index"
                               class="btn btn-outline-powerzone rounded-pill px-4">
                                Paket Değiştir
                            </a>

                        </div>
                    </div>
                }
                else
                {
                    <div class="card shadow-sm p-4 rounded-4 h-100">
                        <h5 class="fw-bold text-teal mb-2">Paketiniz bulunmuyor</h5>
                        <p class="mb-3">Hemen bir paket seçerek üyeliğinizi başlatabilirsiniz.</p>

                        <a asp-controller="Paket"
                           asp-action="Index"
                           class="btn btn-powerzone rounded-pill px-4">
                            Paket Seç
                        </a>
                    </div>
                }

            </div>

            <!-- PROFİL -->
            <div class="col-md-4">
                <div class="card shadow-sm p-4 text-center h-100">
                    <h5 class="fw-bold">Profilim</h5>
                    <p class="text-muted">Bilgilerini güncelle</p>

                    <a asp-controller="Uye"
                       asp-action="Edit"
                       class="btn btn-powerzone rounded-pill mt-3">
                        Profilimi Düzenle
                    </a>
                </div>
            </div>

        </div>

    </div>

    <!-- RANDEVULARIM -->
    <div class="mt-5">
        <h4 class="fw-bold mb-3">Randevularım</h4>

        @if (ViewBag.Randevular != null && ViewBag.Randevular.Count > 0)
        {
            <div class="card shadow-sm p-4 rounded-4">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Tarih</th>
                            <th>Saat</th>
                            <th>Antrenör</th>
                            <th>Hizmet</th>
                            <th>Süre</th>
                            <th>Durum</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in ViewBag.Randevular)
                        {
                            <tr>
                                <td>@r.TarihSaat.ToString("dd.MM.yyyy")</td>
                                <td>@r.TarihSaat.ToString("HH:mm")</td>
                                <td>@r.Antrenor?.AdSoyad</td>
                                <td>@r.Hizmet?.Ad</td>
                                <td>@r.SureDakika dk</td>
                                <td>
                                    @if (r.Durum == "Reddedildi")
                                    {
                                        <span class="badge bg-danger">
                                            Reddedildi
                                        </span>

                                        @if (!string.IsNullOrEmpty(r.ReddetmeSebebi))
                                        {
                                            <div class="text-muted small mt-1">
                                                Sebep: @r.ReddetmeSebebi
                                            </div>
                                        }
                                    }
                                    else if (r.Durum == "Onaylandı")
                                    {
                                        <span class="badge bg-success">
                                            Onaylandı
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            @r.Durum
                                        </span>
                                    }

                                    @if (r.Durum == "Bekliyor")
                                    {
                                        <a asp-controller="Randevu"
                                           asp-action="Edit"
                                           asp-route-id="@r.Id"
                                           class="btn btn-sm btn-primary">
                                            Düzenle
                                        </a>

                                        <a asp-controller="Randevu"
                                           asp-action="Delete"
                                           asp-route-id="@r.Id"
                                           class="btn btn-sm btn-danger ms-1">
                                            Sil
                                        </a>
                                    }

                                </td>

                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info text-center">
                Henüz alınmış bir randevunuz yok.
            </div>
        }
    </div>

</div>
