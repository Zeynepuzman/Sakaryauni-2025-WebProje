@model WebProje_B231210095.Models.Uye

@{
    ViewData["Title"] = "Kullanıcı Paneli";
}

<div class="container mt-5">

    <h2 class="fw-bold mb-4">
        Hoş geldin, @Model.AdSoyad 👋
    </h2>

    <div class="row g-4">

        @if (ViewBag.AktifPaket != null)
        {
            <div class="card shadow-sm p-4 mb-4 rounded-4">
                <h5 class="fw-bold text-teal mb-2">Aktif Paketiniz</h5>

                <p><strong>Paket:</strong> @ViewBag.AktifPaket.PaketAdi</p>
                <p><strong>Kalan Gün:</strong> @ViewBag.AktifPaket.KalanGun gün</p>

                <div class="d-flex gap-3 mt-3">
                    <a asp-controller="Randevu"
                       asp-action="Create"
                       class="btn btn-powerzone rounded-pill px-4">
                        Randevu Al
                    </a>

                    <a asp-controller="Paket"
                       asp-action="Index"
                       class="btn btn-outline-powerzone rounded-pill px-4">
                        Paket Değiştir
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="card shadow-sm p-4 mb-4 rounded-4">
                <h5 class="fw-bold text-danger">Aktif Paketiniz Yok</h5>
                <p>Randevu alabilmek için bir paket seçmelisiniz.</p>

                <a asp-controller="Paket"
                   asp-action="Index"
                   class="btn btn-powerzone rounded-pill px-4">
                    Paket Seç
                </a>
            </div>
        }

        <!-- PROFİL -->
        <div class="col-md-4">
            <div class="card shadow-sm p-4 text-center">
                <h5 class="fw-bold">Profilim</h5>
                <p class="text-muted">Bilgilerini güncelle</p>

                <a asp-controller="Uye"
                   asp-action="Edit"
                   class="btn btn-powerzone rounded-pill">
                    Profilimi Düzenle
                </a>
            </div>
        </div>

        <!-- PAKETLER -->
        <div class="col-md-4">
            <div class="card shadow-sm p-4 text-center">
                <h5 class="fw-bold">Paketler</h5>
                <p class="text-muted">Sana uygun paketleri incele</p>

                <a asp-controller="Paket"
                   asp-action="Index"
                   class="btn btn-powerzone">
                    Paketleri Gör
                </a>
            </div>
        </div>

        <!-- RANDEVU -->
        <div class="col-md-4">
            <div class="card shadow-sm p-4 text-center">
                <h5 class="fw-bold">Randevu</h5>
                <p class="text-muted">Randevularını görüntüle</p>

                <a asp-controller="Uye"
                   asp-action="Dashboard"
                   class="btn btn-outline-powerzone rounded-pill px-4">
                    Aşağıda Gör
                </a>
            </div>
        </div>

    </div>

    <!-- RANDEVULARIM -->
    <div class="mt-5">
        <h4 class="fw-bold mb-3">Randevularım</h4>

        @if (ViewBag.Randevular != null && ViewBag.Randevular.Count > 0)
        {
            <div class="card shadow-sm p-4 rounded-4">
                <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                            <th>Tarih</th>
                            <th>Saat</th>
                            <th>Antrenör</th>
                            <th>Hizmet</th>
                            <th>Süre</th>
                            <th>Durum</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in ViewBag.Randevular)
                        {
                            <tr>
                                <td>@r.TarihSaat.ToString("dd.MM.yyyy")</td>
                                <td>@r.TarihSaat.ToString("HH:mm")</td>
                                <td>@r.Antrenor?.AdSoyad</td>
                                <td>@r.Hizmet?.Ad</td>
                                <td>@r.SureDakika dk</td>
                                <td>@r.Durum</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="alert alert-info text-center">
                Henüz alınmış bir randevunuz yok.
            </div>
        }
    </div>

</div>
