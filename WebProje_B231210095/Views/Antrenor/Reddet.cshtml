@model Randevu

<h3>Randevu Reddet</h3>

<p>
    <strong>Üye:</strong> @Model.Uye.AdSoyad <br />
    <strong>Tarih:</strong> @Model.TarihSaat.ToString("dd.MM.yyyy HH:mm")
</p>

<form method="post">
    <input type="hidden" name="id" value="@Model.Id" />

    <div class="mb-3">
        <label class="form-label">Reddetme Sebebi</label>
        <textarea name="reddetmeSebebi"
                  class="form-control"
                  rows="3"
                  required></textarea>
    </div>

    <button type="submit" class="btn btn-danger">
        Reddet
    </button>
</form>
