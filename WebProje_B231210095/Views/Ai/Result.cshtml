@model WebProje_B231210095.Models.AiResultViewModel

@{
    ViewData["Title"] = "Yapay Zekâ Önerisi";
}

<div class="container mt-5">
    <div class="card shadow p-4 rounded-4">

        <h3 class="fw-bold mb-3">
            🤖 Yapay Zekâ Destekli Öneri
        </h3>

        <!-- 🧠 Yapay zekâ metni -->
        <div class="mb-4">
            <p style="white-space: pre-line;">
                @Model.ResultText
            </p>
        </div>

        <hr />

        <!-- 📌 Vücut etkisi -->
        <h5 class="fw-semibold">📌 Tahmini Vücut Etkisi</h5>
        <p>
            @Model.BodyDescription
        </p>

        @if (!string.IsNullOrEmpty(Model.SuggestedImage))
        {
            <img src="@Model.SuggestedImage"
                 class="img-fluid rounded shadow mt-3"
                 alt="Tahmini vücut dönüşümü" />
        }
        else
        {
            <div class="alert alert-warning mt-3">
                Temsili görsel bulunamadı. Metin önerileri geçerlidir.
            </div>
        }


        <hr />

        <!-- 🔓 GİRİŞ ZORUNLU DEĞİL -->
        <div class="mt-4">
            <p class="fw-semibold">
                Daha detaylı ve kişisel bir program oluşturmak ister misin?
            </p>

            <div class="d-grid gap-2">
                <!-- Giriş yapmak isterse -->
                <a asp-controller="Account"
                   asp-action="Login"
                   class="btn btn-powerzone">
                    Evet, Giriş Yaparak Devam Et
                </a>

                <a asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-powerzone-outline">
                    Hayır, Şimdilik Yeterli
                </a>
            </div>
        </div>

    </div>
</div>
