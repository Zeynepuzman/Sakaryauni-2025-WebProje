@model List<WebProje_B231210095.Models.Randevu>

@{
    ViewData["Title"] = "Bugünkü Randevular";
}

<h2 class="fw-bold mb-4">Bugünkü Randevular</h2>

@if (!Model.Any())
{
    <div class="alert alert-info">
        Bugün için randevu bulunmamaktadır.
    </div>
}
else
{
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>Üye</th>
                <th>Antrenör</th>
                <th>Hizmet</th>
                <th>Tarih</th>
                <th>Saat</th>
                <th>Süre</th>
                <th>Durum</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>@r.Uye.AdSoyad</td>
                    <td>@r.Antrenor.AdSoyad</td>
                    <td>@r.Hizmet.Ad</td>
                    <td>@r.TarihSaat.ToString("dd.MM.yyyy")</td>
                    <td>@r.TarihSaat.ToString("HH:mm")</td>
                    <td>@r.SureDakika dk</td>
                    <td>@r.Durum</td>
                </tr>
            }
        </tbody>
    </table>
}
